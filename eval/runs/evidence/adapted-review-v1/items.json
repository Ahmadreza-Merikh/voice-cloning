[{"id": "a12", "text": "خواهرم کیف پولش را در مترو جا گذاشت و تا خانه پیاده رفت.", "words": ["خواهرم", "کیف", "پولش", "را", "در", "مترو", "جا", "گذاشت", "و", "تا", "خانه", "پیاده", "رفت"], "slots": [{"slot": 1, "audio": "audio/4e9cee48c85e.wav"}, {"slot": 2, "audio": "audio/cdf58cbdbb0a.wav"}, {"slot": 3, "audio": "audio/084935322261.wav"}]}, {"id": "a09", "text": "پرستار با دستمال کاغذی پیشانی بیمار را پاک کرد.", "words": ["پرستار", "با", "دستمال", "کاغذی", "پیشانی", "بیمار", "را", "پاک", "کرد"], "slots": [{"slot": 1, "audio": "audio/b539dc76a801.wav"}, {"slot": 2, "audio": "audio/34348aab679a.wav"}, {"slot": 3, "audio": "audio/b3512cbd6187.wav"}]}, {"id": "a08", "text": "قندان و کتری را از کابینت آشپزخانه برداشتم.", "words": ["قندان", "و", "کتری", "را", "از", "کابینت", "آشپزخانه", "برداشتم"], "slots": [{"slot": 1, "audio": "audio/a5b35bbe0df0.wav"}, {"slot": 2, "audio": "audio/b4fd0c33cfb1.wav"}, {"slot": 3, "audio": "audio/408b23ee1baa.wav"}]}, {"id": "a01", "text": "همسایه بالایی هر شب ساعت ده چراغ‌های حیاط را خاموش می‌کند.", "words": ["همسایه", "بالایی", "هر", "شب", "ساعت", "ده", "چراغ‌های", "حیاط", "را", "خاموش", "می‌کند"], "slots": [{"slot": 1, "audio": "audio/17924ce906bf.wav"}, {"slot": 2, "audio": "audio/16ef0d6ed22a.wav"}, {"slot": 3, "audio": "audio/04f7f3e13a3a.wav"}]}, {"id": "a10", "text": "نجار با اره و چکش یک صندلی چوبی ساخت.", "words": ["نجار", "با", "اره", "و", "چکش", "یک", "صندلی", "چوبی", "ساخت"], "slots": [{"slot": 1, "audio": "audio/23c007d3e110.wav"}, {"slot": 2, "audio": "audio/8da9bc429fc7.wav"}, {"slot": 3, "audio": "audio/9105bcc6d21a.wav"}]}, {"id": "a06", "text": "راننده تاکسی آرام از کنار ماشین‌های پارک‌شده گذشت.", "words": ["راننده", "تاکسی", "آرام", "از", "کنار", "ماشین‌های", "پارک‌شده", "گذشت"], "slots": [{"slot": 1, "audio": "audio/d07c72206855.wav"}, {"slot": 2, "audio": "audio/17668f4fe5fd.wav"}, {"slot": 3, "audio": "audio/95389c6be6bb.wav"}]}, {"id": "a02", "text": "دانشجوها معمولاً شب امتحان تا صبح بیدار می‌مانند.", "words": ["دانشجوها", "معمولاً", "شب", "امتحان", "تا", "صبح", "بیدار", "می‌مانند"], "slots": [{"slot": 1, "audio": "audio/87e63a533b9c.wav"}, {"slot": 2, "audio": "audio/ed625725efe9.wav"}, {"slot": 3, "audio": "audio/e19a54525e2c.wav"}]}, {"id": "a04", "text": "باغبان پیر درختان سیب را با دقت هرس کرد.", "words": ["باغبان", "پیر", "درختان", "سیب", "را", "با", "دقت", "هرس", "کرد"], "slots": [{"slot": 1, "audio": "audio/d5a37c517475.wav"}, {"slot": 2, "audio": "audio/2d801940cbdd.wav"}, {"slot": 3, "audio": "audio/6da15c625c08.wav"}]}, {"id": "a11", "text": "کلاغ‌ها روی سیم برق صف کشیده بودند و قارقار می‌کردند.", "words": ["کلاغ‌ها", "روی", "سیم", "برق", "صف", "کشیده", "بودند", "و", "قارقار", "می‌کردند"], "slots": [{"slot": 1, "audio": "audio/734dd1840d3a.wav"}, {"slot": 2, "audio": "audio/ca3e2dac0d6a.wav"}, {"slot": 3, "audio": "audio/61c194f392b0.wav"}]}, {"id": "a07", "text": "بچه دستکش‌هایش را روی بخاری گذاشت تا خشک شوند.", "words": ["بچه", "دستکش‌هایش", "را", "روی", "بخاری", "گذاشت", "تا", "خشک", "شوند"], "slots": [{"slot": 1, "audio": "audio/b48d5cf09160.wav"}, {"slot": 2, "audio": "audio/8637c1016627.wav"}, {"slot": 3, "audio": "audio/0c6eb6886b15.wav"}]}, {"id": "a05", "text": "کودکان در حیاط مدرسه توپ بازی می‌کردند و معلم از پنجره نگاهشان می‌کرد.", "words": ["کودکان", "در", "حیاط", "مدرسه", "توپ", "بازی", "می‌کردند", "و", "معلم", "از", "پنجره", "نگاهشان", "می‌کرد"], "slots": [{"slot": 1, "audio": "audio/01700e3a28ed.wav"}, {"slot": 2, "audio": "audio/67f4aff82167.wav"}, {"slot": 3, "audio": "audio/6fd7adf6199f.wav"}]}, {"id": "a03", "text": "مادربزرگ هر جمعه برای نوه‌هایش کتلت می‌پزد.", "words": ["مادربزرگ", "هر", "جمعه", "برای", "نوه‌هایش", "کتلت", "می‌پزد"], "slots": [{"slot": 1, "audio": "audio/c3d583b2dbbd.wav"}, {"slot": 2, "audio": "audio/c41c9a21cbac.wav"}, {"slot": 3, "audio": "audio/d8e1f252110f.wav"}]}]