# Voice library holds user speaker data (audio + embeddings) - keep it local.
voices/
!voices/.gitkeep

# Downloaded training corpora. Gigabytes, and reproducible from the prepare
# script plus the manifest, so the recipe is what gets tracked, not the audio.
data/

# Generated audio
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.opus
# ...but keep curated demo assets that are intentionally tracked.
!assets/samples/*.wav

# Gradio
gradio_cached_examples/
flagged/

