[{"id": "r09", "text": "لیوان چای را روی میز گذاشت و کتابش را روی زانویش باز کرد.", "words": ["لیوان", "چای", "را", "روی", "میز", "گذاشت", "و", "کتابش", "را", "روی", "زانویش", "باز", "کرد"], "slots": [{"slot": 1, "audio": "audio/d1e923073b32.wav"}, {"slot": 2, "audio": "audio/4a5d4be592ea.wav"}]}, {"id": "r03", "text": "بچه‌ها با گچ رنگی روی دیوار حیاط نقاشی کشیده بودند.", "words": ["بچه‌ها", "با", "گچ", "رنگی", "روی", "دیوار", "حیاط", "نقاشی", "کشیده", "بودند"], "slots": [{"slot": 1, "audio": "audio/c4eed805537c.wav"}, {"slot": 2, "audio": "audio/0a5f4a80aa4f.wav"}]}, {"id": "r08", "text": "کارشناس با ماژیک قرمز روی نقشه شهر چند نقطه را علامت زد.", "words": ["کارشناس", "با", "ماژیک", "قرمز", "روی", "نقشه", "شهر", "چند", "نقطه", "را", "علامت", "زد"], "slots": [{"slot": 1, "audio": "audio/092a0dea3ff0.wav"}, {"slot": 2, "audio": "audio/cb4fc522ec12.wav"}]}, {"id": "r05", "text": "اسم هر مهمان را روی یک کارت سفید نوشتیم و کنار بشقابش گذاشتیم.", "words": ["اسم", "هر", "مهمان", "را", "روی", "یک", "کارت", "سفید", "نوشتیم", "و", "کنار", "بشقابش", "گذاشتیم"], "slots": [{"slot": 1, "audio": "audio/72d6ed0e5174.wav"}, {"slot": 2, "audio": "audio/e9d66f2254fe.wav"}]}, {"id": "r07", "text": "برف سنگین روی سقف خانه‌های روستا نشسته بود.", "words": ["برف", "سنگین", "روی", "سقف", "خانه‌های", "روستا", "نشسته", "بود"], "slots": [{"slot": 1, "audio": "audio/5d1c5e78f579.wav"}, {"slot": 2, "audio": "audio/105c17fc29eb.wav"}]}, {"id": "r01", "text": "گربه آرام روی مبل خوابیده بود و به صدای باران گوش می‌داد.", "words": ["گربه", "آرام", "روی", "مبل", "خوابیده", "بود", "و", "به", "صدای", "باران", "گوش", "می‌داد"], "slots": [{"slot": 1, "audio": "audio/2f74cb30dde5.wav"}, {"slot": 2, "audio": "audio/02ff9159632a.wav"}]}, {"id": "r02", "text": "مادرم گلدان کوچک را روی طاقچه گذاشت تا آفتاب به آن برسد.", "words": ["مادرم", "گلدان", "کوچک", "را", "روی", "طاقچه", "گذاشت", "تا", "آفتاب", "به", "آن", "برسد"], "slots": [{"slot": 1, "audio": "audio/e022725024ad.wav"}, {"slot": 2, "audio": "audio/9180bd1e6c41.wav"}]}, {"id": "r04", "text": "هواپیما ساعت‌ها روی ابرها پرواز کرد و سرانجام در فرودگاه نشست.", "words": ["هواپیما", "ساعت‌ها", "روی", "ابرها", "پرواز", "کرد", "و", "سرانجام", "در", "فرودگاه", "نشست"], "slots": [{"slot": 1, "audio": "audio/64ff14d902d1.wav"}, {"slot": 2, "audio": "audio/b1e72a2d6123.wav"}]}, {"id": "r06", "text": "پیرمرد هر صبح روی نیمکت پارک می‌نشیند و روزنامه می‌خواند.", "words": ["پیرمرد", "هر", "صبح", "روی", "نیمکت", "پارک", "می‌نشیند", "و", "روزنامه", "می‌خواند"], "slots": [{"slot": 1, "audio": "audio/9ed11b924757.wav"}, {"slot": 2, "audio": "audio/13cc0de6d001.wav"}]}, {"id": "r10", "text": "کودک روی پنجه پا ایستاد تا بتواند از روی دیوار باغ را ببیند.", "words": ["کودک", "روی", "پنجه", "پا", "ایستاد", "تا", "بتواند", "از", "روی", "دیوار", "باغ", "را", "ببیند"], "slots": [{"slot": 1, "audio": "audio/24010bb609fa.wav"}, {"slot": 2, "audio": "audio/b413ca1816e7.wav"}]}]