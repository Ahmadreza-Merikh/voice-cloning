[{"id": "n06", "text": "قیمت دلار در بازار آزاد روز یکشنبه پایین آمد و معامله‌گران منتظر تصمیم بانک مرکزی هستند.", "words": ["قیمت", "دلار", "در", "بازار", "آزاد", "روز", "یکشنبه", "پایین", "آمد", "و", "معامله‌گران", "منتظر", "تصمیم", "بانک", "مرکزی", "هستند"], "slots": [{"slot": 1, "audio": "audio/a86b5b896ef9.wav"}, {"slot": 2, "audio": "audio/c05089220d27.wav"}, {"slot": 3, "audio": "audio/e8af99ce917c.wav"}, {"slot": 4, "audio": "audio/0f18861f3ed3.wav"}]}, {"id": "n03", "text": "تیم ملی فوتبال جمعه شب در ورزشگاه آزادی با نتیجه دو بر یک به حریف عراقی خود باخت.", "words": ["تیم", "ملی", "فوتبال", "جمعه", "شب", "در", "ورزشگاه", "آزادی", "با", "نتیجه", "دو", "بر", "یک", "به", "حریف", "عراقی", "خود", "باخت"], "slots": [{"slot": 1, "audio": "audio/d357f9bf877c.wav"}, {"slot": 2, "audio": "audio/b706d05de020.wav"}, {"slot": 3, "audio": "audio/767e31c553db.wav"}, {"slot": 4, "audio": "audio/599cafb2fcf9.wav"}]}, {"id": "n08", "text": "وزارت نیرو از مردم خواست در ساعت‌های اوج مصرف، از روشن کردن کولرها و وسایل پرمصرف خودداری کنند.", "words": ["وزارت", "نیرو", "از", "مردم", "خواست", "در", "ساعت‌های", "اوج", "مصرف", "از", "روشن", "کردن", "کولرها", "و", "وسایل", "پرمصرف", "خودداری", "کنند"], "slots": [{"slot": 1, "audio": "audio/ff8b1b56eda9.wav"}, {"slot": 2, "audio": "audio/62ca29dee59c.wav"}, {"slot": 3, "audio": "audio/7b91bfb7baa8.wav"}, {"slot": 4, "audio": "audio/2442d8b42067.wav"}]}, {"id": "n05", "text": "پژوهشگران دانشگاه تهران موفق شدند دارویی برای درمان سرطان خون بسازند که هزینه کمتری دارد.", "words": ["پژوهشگران", "دانشگاه", "تهران", "موفق", "شدند", "دارویی", "برای", "درمان", "سرطان", "خون", "بسازند", "که", "هزینه", "کمتری", "دارد"], "slots": [{"slot": 1, "audio": "audio/733db6f39e42.wav"}, {"slot": 2, "audio": "audio/53e31bd7ef4a.wav"}, {"slot": 3, "audio": "audio/c5c81d144a21.wav"}, {"slot": 4, "audio": "audio/784fd701920f.wav"}]}, {"id": "n07", "text": "جشنواره فیلم فجر امسال در بهمن ماه برگزار می‌شود و هشتاد فیلم کوتاه و بلند در آن حضور دارند.", "words": ["جشنواره", "فیلم", "فجر", "امسال", "در", "بهمن", "ماه", "برگزار", "می‌شود", "و", "هشتاد", "فیلم", "کوتاه", "و", "بلند", "در", "آن", "حضور", "دارند"], "slots": [{"slot": 1, "audio": "audio/ae312917608d.wav"}, {"slot": 2, "audio": "audio/d1c9ef56ee8f.wav"}, {"slot": 3, "audio": "audio/50f842d18d0a.wav"}, {"slot": 4, "audio": "audio/6552f355f235.wav"}]}, {"id": "n01", "text": "شرکت سامسونگ اعلام کرد گوشی‌های تاشوی جدیدش را از دوشنبه دوازدهم اکتبر در فروشگاه‌های اروپا عرضه می‌کند.", "words": ["شرکت", "سامسونگ", "اعلام", "کرد", "گوشی‌های", "تاشوی", "جدیدش", "را", "از", "دوشنبه", "دوازدهم", "اکتبر", "در", "فروشگاه‌های", "اروپا", "عرضه", "می‌کند"], "slots": [{"slot": 1, "audio": "audio/814e7716e6fa.wav"}, {"slot": 2, "audio": "audio/82675469afc3.wav"}, {"slot": 3, "audio": "audio/9ebaa432444f.wav"}, {"slot": 4, "audio": "audio/343635711fa6.wav"}]}, {"id": "n02", "text": "به گفته مدیرعامل این کمپانی، کارخانه تازه مجهز به ربات‌های صنعتی است و تا پایان نوامبر راه‌اندازی می‌شود.", "words": ["به", "گفته", "مدیرعامل", "این", "کمپانی", "کارخانه", "تازه", "مجهز", "به", "ربات‌های", "صنعتی", "است", "و", "تا", "پایان", "نوامبر", "راه‌اندازی", "می‌شود"], "slots": [{"slot": 1, "audio": "audio/85d95821c332.wav"}, {"slot": 2, "audio": "audio/27eaf1ca32b4.wav"}, {"slot": 3, "audio": "audio/f0e4a89297bb.wav"}, {"slot": 4, "audio": "audio/cd10740be3ed.wav"}]}, {"id": "n04", "text": "سازمان هواشناسی پیش‌بینی کرده است که از سه‌شنبه هفته آینده دمای هوا در استان‌های شمالی کاهش می‌یابد.", "words": ["سازمان", "هواشناسی", "پیش‌بینی", "کرده", "است", "که", "از", "سه‌شنبه", "هفته", "آینده", "دمای", "هوا", "در", "استان‌های", "شمالی", "کاهش", "می‌یابد"], "slots": [{"slot": 1, "audio": "audio/bff1261647ab.wav"}, {"slot": 2, "audio": "audio/1bb4cabda8e0.wav"}, {"slot": 3, "audio": "audio/4f2d47db2d83.wav"}, {"slot": 4, "audio": "audio/2acd30009ffa.wav"}]}]