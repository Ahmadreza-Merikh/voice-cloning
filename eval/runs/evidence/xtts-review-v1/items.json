[{"id": "x09", "text": "قیمت طلا در بازار جهانی پس از اعلام تصمیم بانک مرکزی آمریکا به بالاترین سطح خود رسید.", "words": ["قیمت", "طلا", "در", "بازار", "جهانی", "پس", "از", "اعلام", "تصمیم", "بانک", "مرکزی", "آمریکا", "به", "بالاترین", "سطح", "خود", "رسید"], "slots": [{"slot": 1, "audio": "audio/9e6f367d2c22.wav"}, {"slot": 2, "audio": "audio/63865a180d7c.wav"}]}, {"id": "x03", "text": "باشگاه پرسپولیس در دیدار هفته هشتم لیگ برتر با دو گل مقابل میزبان خود به پیروزی رسید.", "words": ["باشگاه", "پرسپولیس", "در", "دیدار", "هفته", "هشتم", "لیگ", "برتر", "با", "دو", "گل", "مقابل", "میزبان", "خود", "به", "پیروزی", "رسید"], "slots": [{"slot": 1, "audio": "audio/6433d84a1df4.wav"}, {"slot": 2, "audio": "audio/b102ab3116da.wav"}]}, {"id": "x08", "text": "ناسا اعلام کرد فضاپیمای جدیدش در ماه دسامبر به سمت مریخ پرتاب می‌شود.", "words": ["ناسا", "اعلام", "کرد", "فضاپیمای", "جدیدش", "در", "ماه", "دسامبر", "به", "سمت", "مریخ", "پرتاب", "می‌شود"], "slots": [{"slot": 1, "audio": "audio/ff5d60d0f155.wav"}, {"slot": 2, "audio": "audio/3450e0f2de6e.wav"}]}, {"id": "x05", "text": "قطار سریع‌السیر تهران به مشهد از ابتدای آذر با سرعت ۲۰۰ کیلومتر در ساعت حرکت خواهد کرد.", "words": ["قطار", "سریع‌السیر", "تهران", "به", "مشهد", "از", "ابتدای", "آذر", "با", "سرعت", "۲۰۰", "کیلومتر", "در", "ساعت", "حرکت", "خواهد", "کرد"], "slots": [{"slot": 1, "audio": "audio/e2842ba24b41.wav"}, {"slot": 2, "audio": "audio/7604d22dd63d.wav"}]}, {"id": "x07", "text": "نمایشگاه بین‌المللی کتاب امسال در اردیبهشت برگزار می‌شود و ناشران خارجی هم در آن حضور دارند.", "words": ["نمایشگاه", "بین‌المللی", "کتاب", "امسال", "در", "اردیبهشت", "برگزار", "می‌شود", "و", "ناشران", "خارجی", "هم", "در", "آن", "حضور", "دارند"], "slots": [{"slot": 1, "audio": "audio/fd933e157cbb.wav"}, {"slot": 2, "audio": "audio/39dca71d4aa9.wav"}]}, {"id": "x01", "text": "بانک مرکزی اعلام کرد نرخ تورم ماهانه در مهرماه به ۳ درصد رسیده و انتظار می‌رود تا پایان سال کاهش یابد.", "words": ["بانک", "مرکزی", "اعلام", "کرد", "نرخ", "تورم", "ماهانه", "در", "مهرماه", "به", "۳", "درصد", "رسیده", "و", "انتظار", "می‌رود", "تا", "پایان", "سال", "کاهش", "یابد"], "slots": [{"slot": 1, "audio": "audio/58d0d6d29c2c.wav"}, {"slot": 2, "audio": "audio/331b667031b9.wav"}]}, {"id": "x02", "text": "شرکت مایکروسافت روز سه‌شنبه نسخه تازه سیستم‌عامل ویندوز را برای کاربران سراسر جهان منتشر کرد.", "words": ["شرکت", "مایکروسافت", "روز", "سه‌شنبه", "نسخه", "تازه", "سیستم‌عامل", "ویندوز", "را", "برای", "کاربران", "سراسر", "جهان", "منتشر", "کرد"], "slots": [{"slot": 1, "audio": "audio/6e1d1b62f662.wav"}, {"slot": 2, "audio": "audio/236e63243fd0.wav"}]}, {"id": "x04", "text": "طبق گزارش سازمان بهداشت جهانی، شمار مبتلایان به آنفلوانزا در اروپا نسبت به سال گذشته افزایش یافته است.", "words": ["طبق", "گزارش", "سازمان", "بهداشت", "جهانی", "شمار", "مبتلایان", "به", "آنفلوانزا", "در", "اروپا", "نسبت", "به", "سال", "گذشته", "افزایش", "یافته", "است"], "slots": [{"slot": 1, "audio": "audio/768d71c3d3dd.wav"}, {"slot": 2, "audio": "audio/2d7b91eb9dee.wav"}]}, {"id": "x06", "text": "پلیس راهور از رانندگان خواست در روزهای بارانی سرعت خود را کاهش دهند و فاصله ایمنی را رعایت کنند.", "words": ["پلیس", "راهور", "از", "رانندگان", "خواست", "در", "روزهای", "بارانی", "سرعت", "خود", "را", "کاهش", "دهند", "و", "فاصله", "ایمنی", "را", "رعایت", "کنند"], "slots": [{"slot": 1, "audio": "audio/b1627283a93c.wav"}, {"slot": 2, "audio": "audio/673cdf10b6a9.wav"}]}, {"id": "x10", "text": "وزیر آموزش و پرورش گفت مدارس استان تهران از شنبه آینده به صورت حضوری بازگشایی می‌شوند.", "words": ["وزیر", "آموزش", "و", "پرورش", "گفت", "مدارس", "استان", "تهران", "از", "شنبه", "آینده", "به", "صورت", "حضوری", "بازگشایی", "می‌شوند"], "slots": [{"slot": 1, "audio": "audio/b5736cabd203.wav"}, {"slot": 2, "audio": "audio/43a0480b88c8.wav"}]}]