[{"id": "e12", "text": "دوستم سال گذشته مغازه کوچکی در بازار باز کرد و حالا مشتری‌های زیادی دارد.", "words": ["دوستم", "سال", "گذشته", "مغازه", "کوچکی", "در", "بازار", "باز", "کرد", "و", "حالا", "مشتری‌های", "زیادی", "دارد"], "slots": [{"slot": 1, "audio": "audio/72e7cf4a20c5.wav"}, {"slot": 2, "audio": "audio/5307573d1f11.wav"}, {"slot": 3, "audio": "audio/7d72a577510c.wav"}]}, {"id": "e09", "text": "بعد از شام پدربزرگ برای همه چای ریخت و از خاطره‌های جوانی‌اش گفت.", "words": ["بعد", "از", "شام", "پدربزرگ", "برای", "همه", "چای", "ریخت", "و", "از", "خاطره‌های", "جوانی‌اش", "گفت"], "slots": [{"slot": 1, "audio": "audio/da1636d1b824.wav"}, {"slot": 2, "audio": "audio/d806f1a914cd.wav"}, {"slot": 3, "audio": "audio/af9cd6252cb2.wav"}]}, {"id": "e08", "text": "پسر همسایه دیشب تا دیروقت در کوچه با دوستانش فوتبال بازی می‌کرد.", "words": ["پسر", "همسایه", "دیشب", "تا", "دیروقت", "در", "کوچه", "با", "دوستانش", "فوتبال", "بازی", "می‌کرد"], "slots": [{"slot": 1, "audio": "audio/1128d436a4cc.wav"}, {"slot": 2, "audio": "audio/16f76f739d87.wav"}, {"slot": 3, "audio": "audio/a311a8466598.wav"}]}, {"id": "e01", "text": "وزارت نیرو اعلام کرد مصرف برق خانگی در تابستان امسال هشت درصد کمتر از پارسال بوده است.", "words": ["وزارت", "نیرو", "اعلام", "کرد", "مصرف", "برق", "خانگی", "در", "تابستان", "امسال", "هشت", "درصد", "کمتر", "از", "پارسال", "بوده", "است"], "slots": [{"slot": 1, "audio": "audio/72dbd8813289.wav"}, {"slot": 2, "audio": "audio/bade21b867d3.wav"}, {"slot": 3, "audio": "audio/7c5f87e819d8.wav"}]}, {"id": "e10", "text": "امروز عصر خواهر کوچکم نقاشی تازه‌اش را با ذوق به همه نشان داد.", "words": ["امروز", "عصر", "خواهر", "کوچکم", "نقاشی", "تازه‌اش", "را", "با", "ذوق", "به", "همه", "نشان", "داد"], "slots": [{"slot": 1, "audio": "audio/4546c1cf7159.wav"}, {"slot": 2, "audio": "audio/02b44ae4a36e.wav"}, {"slot": 3, "audio": "audio/e0297f1c8c8e.wav"}]}, {"id": "e06", "text": "پزشکان بیمارستان کودکان شیراز دیروز نخستین عمل پیوند قلب این استان را با موفقیت انجام دادند.", "words": ["پزشکان", "بیمارستان", "کودکان", "شیراز", "دیروز", "نخستین", "عمل", "پیوند", "قلب", "این", "استان", "را", "با", "موفقیت", "انجام", "دادند"], "slots": [{"slot": 1, "audio": "audio/ef742b2dd397.wav"}, {"slot": 2, "audio": "audio/318a0f562b43.wav"}, {"slot": 3, "audio": "audio/5891207065df.wav"}]}, {"id": "e02", "text": "مأموران گمرک بندرعباس هفته گذشته محموله بزرگی از لوازم خانگی قاچاق را کشف کردند.", "words": ["مأموران", "گمرک", "بندرعباس", "هفته", "گذشته", "محموله", "بزرگی", "از", "لوازم", "خانگی", "قاچاق", "را", "کشف", "کردند"], "slots": [{"slot": 1, "audio": "audio/b0974c3d32f0.wav"}, {"slot": 2, "audio": "audio/de7719c0b663.wav"}, {"slot": 3, "audio": "audio/dab0451df4fd.wav"}]}, {"id": "e04", "text": "هفته پیش قیمت خودروهای داخلی در بازار تهران دوباره بالا رفت.", "words": ["هفته", "پیش", "قیمت", "خودروهای", "داخلی", "در", "بازار", "تهران", "دوباره", "بالا", "رفت"], "slots": [{"slot": 1, "audio": "audio/1ea24e92a230.wav"}, {"slot": 2, "audio": "audio/0d04ab706a86.wav"}, {"slot": 3, "audio": "audio/12b7bebac6d5.wav"}]}, {"id": "e11", "text": "راننده اتوبوس وسط راه ایستاد و از مسافران خواست کمربندهایشان را ببندند.", "words": ["راننده", "اتوبوس", "وسط", "راه", "ایستاد", "و", "از", "مسافران", "خواست", "کمربندهایشان", "را", "ببندند"], "slots": [{"slot": 1, "audio": "audio/b343e078c319.wav"}, {"slot": 2, "audio": "audio/9b20c38670ec.wav"}, {"slot": 3, "audio": "audio/480059765117.wav"}]}, {"id": "e07", "text": "مادرم هر روز صبح قبل از رفتن به اداره گلدان‌های بالکن را آب می‌دهد.", "words": ["مادرم", "هر", "روز", "صبح", "قبل", "از", "رفتن", "به", "اداره", "گلدان‌های", "بالکن", "را", "آب", "می‌دهد"], "slots": [{"slot": 1, "audio": "audio/5a26acf0cfee.wav"}, {"slot": 2, "audio": "audio/5b3abf3b92c3.wav"}, {"slot": 3, "audio": "audio/2a99a7e25fe4.wav"}]}, {"id": "e05", "text": "سازمان هواشناسی برای روزهای پایانی هفته در استان‌های شمالی باران شدید پیش‌بینی کرده است.", "words": ["سازمان", "هواشناسی", "برای", "روزهای", "پایانی", "هفته", "در", "استان‌های", "شمالی", "باران", "ش