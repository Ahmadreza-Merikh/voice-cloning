[{"id": "n09", "text": "مسئول فروشگاه به خاطر تأخیر در تحویل سفارش از مشتری عذرخواهی کرد.", "words": ["مسئول", "فروشگاه", "به", "خاطر", "تأخیر", "در", "تحویل", "سفارش", "از", "مشتری", "عذرخواهی", "کرد"], "slots": [{"slot": 1, "audio": "audio/32f51ba3e966.wav"}, {"slot": 2, "audio": "audio/eaba677b03d8.wav"}, {"slot": 3, "audio": "audio/52e9851fb123.wav"}, {"slot": 4, "audio": "audio/3047d938dd19.wav"}]}, {"id": "n06", "text": "او مردی مهربان و دانشمندی بزرگ بود که همه به حرفش گوش می‌دادند.", "words": ["او", "مردی", "مهربان", "و", "دانشمندی", "بزرگ", "بود", "که", "همه", "به", "حرفش", "گوش", "می‌دادند"], "slots": [{"slot": 1, "audio": "audio/58ecfe772df5.wav"}, {"slot": 2, "audio": "audio/adb33e20d98e.wav"}, {"slot": 3, "audio": "audio/e3baffab7a25.wav"}, {"slot": 4, "audio": "audio/4be175a30ac7.wav"}]}, {"id": "n11", "text": "دیشب رفتیم خونه داداشم، ولی هنوز از سفر برنگشته بود.", "words": ["دیشب", "رفتیم", "خونه", "داداشم", "ولی", "هنوز", "از", "سفر", "برنگشته", "بود"], "slots": [{"slot": 1, "audio": "audio/478b7d812530.wav"}, {"slot": 2, "audio": "audio/ec95966e6f75.wav"}, {"slot": 3, "audio": "audio/940c0d7c909c.wav"}, {"slot": 4, "audio": "audio/bee540c0832c.wav"}]}, {"id": "n08", "text": "کرم این گل‌ها را خورده و باغبان از دیدن برگ‌های سوراخ ناراحت است.", "words": ["کرم", "این", "گل‌ها", "را", "خورده", "و", "باغبان", "از", "دیدن", "برگ‌های", "سوراخ", "ناراحت", "است"], "slots": [{"slot": 1, "audio": "audio/f53465eda2b7.wav"}, {"slot": 2, "audio": "audio/3506bf1010d8.wav"}, {"slot": 3, "audio": "audio/60600807cd37.wav"}, {"slot": 4, "audio": "audio/c9f0fa89cdcb.wav"}]}, {"id": "n02", "text": "دانشجو کتاب را روی میز گذاشت و دو ساعت منتظر استاد ماند.", "words": ["دانشجو", "کتاب", "را", "روی", "میز", "گذاشت", "و", "دو", "ساعت", "منتظر", "استاد", "ماند"], "slots": [{"slot": 1, "audio": "audio/731aa9cd71f5.wav"}, {"slot": 2, "audio": "audio/f93146752c80.wav"}, {"slot": 3, "audio": "audio/46b496110df0.wav"}, {"slot": 4, "audio": "audio/08633ca6b800.wav"}]}, {"id": "n01", "text": "پنجره اتاق خواب خانه مادربزرگم رو به باغ باز می‌شود.", "words": ["پنجره", "اتاق", "خواب", "خانه", "مادربزرگم", "رو", "به", "باغ", "باز", "می‌شود"], "slots": [{"slot": 1, "audio": "audio/fe2fd48afb5c.wav"}, {"slot": 2, "audio": "audio/fe0ed77e90f2.wav"}, {"slot": 3, "audio": "audio/03db0c2bf749.wav"}, {"slot": 4, "audio": "audio/f5f03e28df2a.wav"}]}, {"id": "n12", "text": "بعد از جلسه طولانی هیئت مدیره، مدیر عامل شرکت گفت که قرارداد جدید تا پایان ماه آینده امضا می‌شود.", "words": ["بعد", "از", "جلسه", "طولانی", "هیئت", "مدیره", "مدیر", "عامل", "شرکت", "گفت", "که", "قرارداد", "جدید", "تا", "پایان", "ماه", "آینده", "امضا", "می‌شود"], "slots": [{"slot": 1, "audio": "audio/dad54d9325ac.wav"}, {"slot": 2, "audio": "audio/d2a98bca45b2.wav"}, {"slot": 3, "audio": "audio/8e911e58f847.wav"}, {"slot": 4, "audio": "audio/9af5ea6377b1.wav"}]}, {"id": "n10", "text": "شورای شهر تصمیم گرفت ساعت کار کتابخانه‌های عمومی را در تابستان افزایش دهد.", "words": ["شورای", "شهر", "تصمیم", "گرفت", "ساعت", "کار", "کتابخانه‌های", "عمومی", "را", "در", "تابستان", "افزایش", "دهد"], "slots": [{"slot": 1, "audio": "audio/c7ec1d4546e7.wav"}, {"slot": 2, "audio": "audio/8a8abb90e74f.wav"}, {"slot": 3, "audio": "audio/6ce04757e67c.wav"}, {"slot": 4, "audio": "audio/195c56a33cab.wav"}]}, {"id": "n03", "text": "کشاورز با تبر شاخه‌های خشک درخت را برید و در سبد گذاشت.", "words": ["کشاورز", "با", "تبر", "شاخه‌های", "خشک", "درخت", "را", "برید", "و", "در", "سبد", "گذاشت"], "slots": [{"slot": 1, "audio": "audio/51fac3e0e031.wav"}, {"slot": 2, "audio": "audio/ef888ace2717.wav"}, {"slot": 3, "audio": "audio/705315223bbc.wav"}, {"slot": 4, "audio": "audio/d860e2be3858.wav"}]}, {"id": "n04", "text": "دختر کوچک قفل صندوق را با کلید طلایی باز کرد.", "words": ["دختر", "کوچک", "قفل", "صندوق", "را", "با", "کلید", "طلایی", "باز", "کرد"], "slots": [{"slot": 1, "audio": "audio/9973c73d68c4.wav"}, {"slot": 2, "audio": "audio/1512714d8efe.wav"}, {"slot": 3, "audio": "audio/9ac21379208f.wav"}, {"slot": 4, "audio": "audio/0a4f36814027.wav"}]}, {"id": "n05", "text": "صدای خنده بچه‌ها از کوچه باریک پشت مدرسه می‌آمد.", "words": ["صدای", "خنده", "بچه‌ها", "از", "کوچه", "باریک", "پشت", "مدرسه", "می‌آمد"], "slots": [{"slot": 1, "audio": "audio/6c3a22780418.wav"}, {"slot": 2, "audio": "audio/f320efd9bbd4.wav"}, {"slot": 3, "audio": "audio/a12f608b1d4d.wav"}, {"slot": 4, "audio": "audio/b96726d625bb.wav"}]}, {"id": "n07", "text": "دیروز صبح زود باران شروع شد و تا غروب یک لحظه هم بند نیامد.", "words": ["دیروز", "صبح", "زود", "باران", "شروع", "شد", "و", "تا", "غروب", "یک", "لحظه", "هم", "بند", "نیامد"], "slots": [{"slot": 1, "audio": "audio/f29cd34fbdfc.wav"}, {"slot": 2, "audio": "audio/5d9e686ec739.wav"}, {"slot": 3, "audio": "audio/f01ba9536371.wav"}, {"slot": 4, "audio": "audio/58650cb91b45.wav"}]}]