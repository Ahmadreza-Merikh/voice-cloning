[{"id": "s07", "text": "مسؤول استقبال استاد از سرسرای دانشگاه ایستاد.", "words": ["مسؤول", "استقبال", "استاد", "از", "سرسرای", "دانشگاه", "ایستاد"], "slots": [{"slot": 1, "audio": "audio/4c52f587e009.wav"}, {"slot": 2, "audio": "audio/2dac8641b4a6.wav"}, {"slot": 3, "audio": "audio/5f18b52046b4.wav"}]}, {"id": "s06", "text": "ژاله زیر چراغ، چترش را در باران شدید بست.", "words": ["ژاله", "زیر", "چراغ", "چترش", "را", "در", "باران", "شدید", "بست"], "slots": [{"slot": 1, "audio": "audio/8f904fabff86.wav"}, {"slot": 2, "audio": "audio/c95d116c8250.wav"}, {"slot": 3, "audio": "audio/b9472489bb00.wav"}]}, {"id": "s01", "text": "او گل قرمز را از گل باغچه بیرون کشید.", "words": ["او", "گل", "قرمز", "را", "از", "گل", "باغچه", "بیرون", "کشید"], "slots": [{"slot": 1, "audio": "audio/6eec908ff11e.wav"}, {"slot": 2, "audio": "audio/3416228bf8ca.wav"}, {"slot": 3, "audio": "audio/1df641ac8726.wav"}]}, {"id": "s02", "text": "پیرمرد گفت این مرد هفتهٔ پیش مرده است.", "words": ["پیرمرد", "گفت", "این", "مرد", "هفتهٔ", "پیش", "مرده", "است"], "slots": [{"slot": 1, "audio": "audio/958ff3f9050a.wav"}, {"slot": 2, "audio": "audio/378e41d088bb.wav"}, {"slot": 3, "audio": "audio/b9308a2570ca.wav"}]}, {"id": "s09", "text": "وقتی مترو از ایستگاه ترمینال جنوب رد شد، خانمی که کنار پنجره نشسته بود کتابش را بست، کیفش را برداشت و به سمت در رفت، بیآنکه متوجه شود ایستگاه بعدی همان مقصدی است که نیم ساعت پیش از آن آمده بود.", "words": ["وقتی", "مترو", "از", "ایستگاه", "ترمینال", "جنوب", "رد", "شد", "خانمی", "که", "کنار", "پنجره", "نشسته", "بود", "کتابش", "را", "بست", "کیفش", "را", "برداشت", "و", "به", "سمت", "در", "رفت", "بیآنکه", "متوجه", "شود", "ایستگاه", "بعدی", "همان", "مقصدی", "است", "که", "نیم", "ساعت", "پیش", "از", "آن", "آمده", "بود"], "slots": [{"slot": 1, "audio": "audio/b284347a00e7.wav"}, {"slot": 2, "audio": "audio/2ce33b9151e7.wav"}]}, {"id": "s05", "text": "قلعهٔ قدیمی بالای تپهٔ خاکی، هنگام غروب دیدنی بود.", "words": ["قلعهٔ", "قدیمی", "بالای", "تپهٔ", "خاکی", "هنگام", "غروب", "دیدنی", "بود"], "slots": [{"slot": 1, "audio": "audio/f84c1112037b.wav"}, {"slot": 2, "audio": "audio/d533b5d203ee.wav"}, {"slot": 3, "audio": "audio/50dcb2c28870.wav"}]}, {"id": "s04", "text": "لیوان آب را روی میز بگذار و روی صورتت آب بکش.", "words": ["لیوان", "آب", "را", "روی", "میز", "بگذار", "و", "روی", "صورتت", "آب", "بکش"], "slots": [{"slot": 1, "audio": "audio/b088d38a142b.wav"}, {"slot": 2, "audio": "audio/8e86c026d27a.wav"}, {"slot": 3, "audio": "audio/95dda16b6523.wav"}]}, {"id": "t09", "text": "پس از پایان مسابقهٔ کشتی، ورزشکاران با کشتی به جزیره برگشتند.", "words": ["پس", "از", "پایان", "مسابقهٔ", "کشتی", "ورزشکاران", "با", "کشتی", "به", "جزیره", "برگشتند"], "slots": [{"slot": 1, "audio": "audio/8adaedfd966c.wav"}, {"slot": 2, "audio": "audio/4cbaa006c418.wav"}, {"slot": 3, "audio": "audio/a22dbfcfdc3a.wav"}]}, {"id": "s08", "text": "برو بابا، این حرفا پیش من خریدار نداره، بشین ببین چی میگم.", "words": ["برو", "بابا", "این", "حرفا", "پیش", "من", "خریدار", "نداره", "بشین", "ببین", "چی", "میگم"], "slots": [{"slot": 1, "audio": "audio/e4d3dac3423d.wav"}, {"slot": 2, "audio": "audio/2738a4305753.wav"}, {"slot": 3, "audio": "audio/fbb8f4887265.wav"}]}, {"id": "s03", "text": "کتاب خوب برادرم روی میز اتاق است.", "words": ["کتاب", "خوب", "برادرم", "روی", "میز", "اتاق", "است"], "slots": [{"slot": 1, "audio": "audio/ff435f7a3412.wav"}, {"slot": 2, "audio": "audio/0c5d02e3854a.wav"}, {"slot": 3, "audio": "audio/34dca895ced2.wav"}]}, {"id": "t10", "text": "دختر همسایهٔ روبه‌رویی ما کتاب تازهٔ نویسندهٔ محبوبش را امانت گرفت.", "words": ["دختر", "همسایهٔ", "روبه‌رویی", "ما", "کتاب", "تازهٔ", "نویسندهٔ", "محبوبش", "را", "امانت", "گرفت"], "slots": [{"slot": 1, "audio": "audio/13a019f97ba3.wav"}, {"slot": 2, "audio": "audio/8d71b165fe4a.wav"}, {"slot": 3, "audio": "audio/86553020deb1.wav"}]}, {"id": "t12", "text": "وقتی به ایستگاه قطار رسیدیم، دیدیم که قطار شبانه به دلیل برف سنگین و بسته شدن جاده‌های کوهستانی دست‌کم سه ساعت تأخیر دارد و مسافران خسته در سالن انتظار نشسته‌اند و چای می‌نوشند.", "words": ["وقتی", "به", "ایستگاه", "قطار", "رسیدیم", "دیدیم", "که", "قطار", "شبانه", "به", "دلیل", "برف", "سنگین", "و", "بسته", "شدن", "جاده‌های", "کوهستانی", "دست‌کم", "سه", "ساعت", "تأخیر", "دارد", "و", "مسافران", "خسته", "در", "سالن", "انتظار", "نشسته‌اند", "و", "چای", "می‌نوشند"], "slots": [{"slot": 1, "audio": "audio/0fabbbe38bc4.wav"}, {"slot": 2, "audio": "audio/d02d99a170bb.wav"}]}, {"id": "t11", "text": "باران بند آمد.", "words": ["باران", "بند", "آمد"], "slots": [{"slot": 1, "audio": "audio/eab0b59dde7c.wav"}, {"slot": 2, "audio": "audio/abb25851a972.wav"}, {"slot": 3, "audio": "audio/713a28c64d20.wav"}]}, {"id": "r01", "text": "به طور خلاصه این مطالعه به این نتیجه رسیده که آسیب بینایی، عاملی تهدیدکننده برای سلامت روانی افراد به شمار می‌رود. با در نظر گرفتن تعداد زیادی پژوهش،", "words": ["به", "طور", "خلاصه", "این", "مطالعه", "به", "این", "نتیجه", "رسیده", "که", "آسیب", "بینایی", "عاملی", "تهدیدکننده", "برای", "سلامت", "روانی", "افراد", "به", "شمار", "می‌رود", "با", "در", "نظر", "گرفتن", "تعداد", "زیادی", "پژوهش"], "slots": [{"slot": 1, "audio": "audio/adf44170c7ad.wav"}, {"slot": 2, "audio": "audio/272abe5f58f3.wav"}]}]