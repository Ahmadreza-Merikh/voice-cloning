[{"id": "v09", "text": "در این محله، قیمت مسکن معمولاً بالاست و موجودی حساب بسیاری از زوج‌های جوان تقریباً صفر است.", "words": ["در", "این", "محله", "قیمت", "مسکن", "معمولاً", "بالاست", "و", "موجودی", "حساب", "بسیاری", "از", "زوج‌های", "جوان", "تقریباً", "صفر", "است"], "slots": [{"slot": 1, "audio": "audio/1d9d9b9175aa.wav"}, {"slot": 2, "audio": "audio/2c4c2a7617bc.wav"}, {"slot": 3, "audio": "audio/b91c6c78446e.wav"}, {"slot": 4, "audio": "audio/dd1f6b87366d.wav"}]}, {"id": "v06", "text": "دانشمندان سال‌ها برای پیشرفت علم پزشکی تلاش کردند و در میان خلق نامشان هنوز با احترام برده می‌شود.", "words": ["دانشمندان", "سال‌ها", "برای", "پیشرفت", "علم", "پزشکی", "تلاش", "کردند", "و", "در", "میان", "خلق", "نامشان", "هنوز", "با", "احترام", "برده", "می‌شود"], "slots": [{"slot": 1, "audio": "audio/1ce588e51fca.wav"}, {"slot": 2, "audio": "audio/b090c01c50cd.wav"}, {"slot": 3, "audio": "audio/c2f66f01b630.wav"}, {"slot": 4, "audio": "audio/fc5e3b793486.wav"}]}, {"id": "v11", "text": "در جلسه دیروز، مدیر بخش بازاریابی گفت که این طرح اصلاً ارزش صرف هزینه ندارد و مبلغ پیشنهادی را رد کرد.", "words": ["در", "جلسه", "دیروز", "مدیر", "بخش", "بازاریابی", "گفت", "که", "این", "طرح", "اصلاً", "ارزش", "صرف", "هزینه", "ندارد", "و", "مبلغ", "پیشنهادی", "را", "رد", "کرد"], "slots": [{"slot": 1, "audio": "audio/a028c65d2da3.wav"}, {"slot": 2, "audio": "audio/4fed9bb0345d.wav"}, {"slot": 3, "audio": "audio/017b83ebc6ba.wav"}, {"slot": 4, "audio": "audio/58a3f490de45.wav"}]}, {"id": "v08", "text": "پزشک گفت که بیمار تا چند روز باید مسکن بخورد، چون تن خسته‌اش هنوز درد می‌کند.", "words": ["پزشک", "گفت", "که", "بیمار", "تا", "چند", "روز", "باید", "مسکن", "بخورد", "چون", "تن", "خسته‌اش", "هنوز", "درد", "می‌کند"], "slots": [{"slot": 1, "audio": "audio/411e31871963.wav"}, {"slot": 2, "audio": "audio/778c9db6f5f6.wav"}, {"slot": 3, "audio": "audio/12f13ccd6107.wav"}, {"slot": 4, "audio": "audio/31cebc9154e2.wav"}]}, {"id": "v02", "text": "در آن سفر طولانی، مسافران معمولاً هنگام غروب روی عرشه کشتی جمع می‌شدند و از دور قهرمان کشتی را تشویق می‌کردند.", "words": ["در", "آن", "سفر", "طولانی", "مسافران", "معمولاً", "هنگام", "غروب", "روی", "عرشه", "کشتی", "جمع", "می‌شدند", "و", "از", "دور", "قهرمان", "کشتی", "را", "تشویق", "می‌کردند"], "slots": [{"slot": 1, "audio": "audio/2ddb2158fb91.wav"}, {"slot": 2, "audio": "audio/924b4d56ffa0.wav"}, {"slot": 3, "audio": "audio/579eddb7bdb3.wav"}, {"slot": 4, "audio": "audio/db0e8c502547.wav"}]}, {"id": "v01", "text": "کاربران در جریان این تعاملات معمولاً اطلاعات بسیار خصوصی درباره زندگی و سلامت روان خود را با هوش مصنوعی در میان می‌گذارند و اغلب از این محصولات به‌عنوان محرم اسرار یا حتی درمانگر استفاده می‌کنند.", "words": ["کاربران", "در", "جریان", "این", "تعاملات", "معمولاً", "اطلاعات", "بسیار", "خصوصی", "درباره", "زندگی", "و", "سلامت", "روان", "خود", "را", "با", "هوش", "مصنوعی", "در", "میان", "می‌گذارند", "و", "اغلب", "از", "این", "محصولات", "به‌عنوان", "محرم", "اسرار", "یا", "حتی", "درمانگر", "استفاده", "می‌کنند"], "slots": [{"slot": 1, "audio": "audio/80ff01bb0866.wav"}, {"slot": 2, "audio": "audio/923b02795190.wav"}, {"slot": 3, "audio": "audio/cffb9d264b1f.wav"}, {"slot": 4, "audio": "audio/abab6e04dcec.wav"}]}, {"id": "v12", "text": "جوانان امروز اغلب به ورزش اهمیت می‌دهند و برخی حتی هنگام سحر در هوای گرم تابستان برای دویدن به پارک می‌روند.", "words": ["جوانان", "امروز", "اغلب", "به", "ورزش", "اهمیت", "می‌دهند", "و", "برخی", "حتی", "هنگام", "سحر", "در", "هوای", "گرم", "تابستان", "برای", "دویدن", "به", "پارک", "می‌روند"], "slots": [{"slot": 1, "audio": "audio/22af15c54df4.wav"}, {"slot": 2, "audio": "audio/991a4fcc3efb.wav"}, {"slot": 3, "audio": "audio/0047da7c204d.wav"}, {"slot": 4, "audio": "audio/3bf3fc0a0303.wav"}]}, {"id": "v10", "text": "کودک بیمار دیشب تا صبح تب داشت و مادرش مدام عرق پیشانی او را پاک می‌کرد و از سر دلسوزی کنارش بیدار ماند.", "words": ["کودک", "بیمار", "دیشب", "تا", "صبح", "تب", "داشت", "و", "مادرش", "مدام", "عرق", "پیشانی", "او", "را", "پاک", "می‌کرد", "و", "از", "سر", "دلسوزی", "کنارش", "بیدار", "ماند"], "slots": [{"slot": 1, "audio": "audio/6ff57abda4ad.wav"}, {"slot": 2, "audio": "audio/9eee8d5b0752.wav"}, {"slot": 3, "audio": "audio/04106f994d20.wav"}, {"slot": 4, "audio": "audio/67ccfad8a45f.wav"}]}, {"id": "v03", "text": "شکر خدا حال مادربزرگ بهتر شد، ولی دکتر تأکید کرد که بیمار هرگز نباید چای را با شکر زیاد بنوشد.", "words": ["شکر", "خدا", "حال", "مادربزرگ", "بهتر", "شد", "ولی", "دکتر", "تأکید", "کرد", "که", "بیمار", "هرگز", "نباید", "چای", "را", "با", "شکر", "زیاد", "بنوشد"], "slots": [{"slot": 1, "audio": "audio/bf2699e9a6a8.wav"}, {"slot": 2, "audio": "audio/9b2f20334bdb.wav"}, {"slot": 3, "audio": "audio/1e48de2c5b2c.wav"}, {"slot": 4, "audio": "audio/1b1263339704.wav"}]}, {"id": "v04", "text": "کارگران همیشه سر ساعت به کارگاه می‌رسند، ولی هنوز هیچ‌کس از سر این ماجرا خبر ندارد.", "words": ["کارگران", "همیشه", "سر", "ساعت", "به", "کارگاه", "می‌رسند", "ولی", "هنوز", "هیچ‌کس", "از", "سر", "این", "ماجرا", "خبر", "ندارد"], "slots": [{"slot": 1, "audio": "audio/722b44ad08da.wav"}, {"slot": 2, "audio": "audio/b6371f158499.wav"}, {"slot": 3, "audio": "audio/5368e54aba53.wav"}, {"slot": 4, "audio": "audio/d90c7e452816.wav"}]}, {"id": "v05", "text": "کارمند فوراً مهر شرکت را روی نامه زد و رئیس با مهر و محبت از او تشکر کرد.", "words": ["کارمند", "فوراً", "مهر", "شرکت", "را", "روی", "نامه", "زد", "و", "رئیس", "با", "مهر", "و", "محبت", "از", "او", "تشکر", "کرد"], "slots": [{"slot": 1, "audio": "audio/38c9e90e0696.wav"}, {"slot": 2, "audio": "audio/8f9a721cb2b1.wav"}, {"slot": 3, "audio": "audio/2a4f6e97b54b.wav"}, {"slot": 4, "audio": "audio/f23e7bfa0d8a.wav"}]}, {"id": "v07", "text": "بچه‌ها پر از شوق بودند، چون پرنده کوچک ناگهان با یک پر سفید روی شاخه نشست.", "words": ["بچه‌ها", "پر", "از", "شوق", "بودند", "چون", "پرنده", "کوچک", "ناگهان", "با", "یک", "پر", "سفید", "روی", "شاخه", "نشست"], "slots": [{"slot": 1, "audio": "audio/ebe53bbf7291.wav"}, {"slot": 2, "audio": "audio/4fbc7a5dd7f8.wav"}, {"slot": 3, "audio": "audio/de074206ec9a.wav"}, {"slot": 4, "audio":